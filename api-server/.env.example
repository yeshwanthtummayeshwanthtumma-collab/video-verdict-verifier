# Copy this file to .env and fill in your real key.
# NEVER commit .env or share it.

# Preferred: Moonshot (Kimi) API key - get one at platform.moonshot.ai
# Note: Moonshot requires a small account top-up (around $1 minimum) before
# a key becomes active for API calls.
MOONSHOT_API_KEY=

# Optional fallback if Moonshot key is not set (also used automatically if a
# Kimi vision call fails, when both keys are present)
OPENAI_API_KEY=
